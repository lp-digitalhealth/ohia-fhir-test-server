# Copy to .env and edit. Never commit .env.

# REQUIRED: choose a long random password for the PostgreSQL user.
POSTGRES_PASSWORD=change-me

# REQUIRED: the interim shared access token. Callers send "Authorization: Bearer <token>"
# on every request except GET /fhir/metadata. Generate one with: openssl rand -hex 32
# Hex only (no spaces or quotes). Keep it out of git and out of chat.
API_TOKEN=change-me

# Public hostname Caddy should serve (it obtains a certificate automatically).
# For plain-HTTP local testing use ":80".
SITE_ADDRESS=:80

# Public base URL, used in links HAPI returns (no trailing slash, no /fhir).
PUBLIC_BASE_URL=http://localhost

# Optional image overrides (for example a registry mirror, or a pinned tag/digest).
# HAPI_IMAGE=hapiproject/hapi:latest
# POSTGRES_IMAGE=postgres:16-alpine
# CADDY_IMAGE=caddy:2-alpine

# Optional host ports (change if 80/443 are taken locally).
# HTTP_PORT=80
# HTTPS_PORT=443
