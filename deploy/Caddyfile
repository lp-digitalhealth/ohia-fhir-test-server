# SITE_ADDRESS is a hostname (Caddy gets a Let's Encrypt certificate automatically)
# or ":80" for plain HTTP (local testing only).
#
# INTERIM AUTH (revisit in January 2027; see docs/OHIA_FHIR_Test_server_PLAN.md S1):
# one shared secret. Every request except /fhir/metadata and CORS preflights (OPTIONS)
# must carry "Authorization: Bearer <API_TOKEN>". API_TOKEN comes from .env and is never
# committed. docker-compose.yml refuses to start without it, so a missing token cannot
# silently leave the server open.
{$SITE_ADDRESS} {
	encode gzip
	# HAPI serves FHIR under /fhir. Large bundles are expected.
	request_body {
		max_size 100MB
	}

	# Open on purpose: discovery (CapabilityStatement) and browser CORS preflights,
	# which never carry an Authorization header.
	# Reads only: matcher types in one block are ANDed, so a write to this path needs the token.
	@meta {
		path /fhir/metadata
		method GET HEAD
	}
	@preflight method OPTIONS
	# Everything else must present the shared token.
	@authed header Authorization "Bearer {$API_TOKEN}"

	# Facade paths (Java service beside HAPI). Declared first because @authed below matches
	# any path. The /fhir routes further down never pass through the facade, so a facade
	# problem cannot break or open the FHIR API. If the facade container is down, these two
	# paths return 502 and nothing else is affected.
	@arex path /arex /arex/*
	@ode path /ode /ode/*

	# The patient-app FHIR base (/patient-access/fhir) is served by the facade, not HAPI. Its capability statement is open
	# (discovery needs no credentials) and CORS preflights go to the facade, which answers them; everything else needs the
	# shared token here and again in the facade. A write is refused by the facade (405), never stored in HAPI.
	@pa_meta {
		path /patient-access/fhir/metadata
		method GET HEAD
	}
	@pa_preflight {
		path /patient-access/fhir /patient-access/fhir/*
		method OPTIONS
	}
	@pa path /patient-access/fhir /patient-access/fhir/*
	@viewer path /viewer /viewer/*

	handle @pa_meta {
		reverse_proxy facade:8080
	}
	handle @pa_preflight {
		reverse_proxy facade:8080
	}
	handle @pa {
		handle @authed {
			reverse_proxy facade:8080
		}
		handle {
			header WWW-Authenticate Bearer
			respond "Unauthorized: send Authorization: Bearer <token>" 401
		}
	}

	# The received-payloads page is static and holds no data and no secrets: it asks the person for the
	# shared token and calls /ode/* with it. So it loads without a token (a browser cannot send one for
	# a page load), and the facade sets its strict browser protections.
	handle @viewer {
		reverse_proxy facade:8080
	}

	# ARex content and its OAuth token endpoint use their own SMART Backend Services tokens,
	# so they are not behind the shared token. The facade enforces them.
	handle @arex {
		reverse_proxy facade:8080
	}
	# Organizer endpoints (seed, send, delivery log): shared token here, and checked again
	# inside the facade.
	handle @ode {
		handle @authed {
			reverse_proxy facade:8080
		}
		handle {
			header WWW-Authenticate Bearer
			respond "Unauthorized: send Authorization: Bearer <token>" 401
		}
	}

	# /fhir: handle blocks are mutually exclusive and are tried in this order.
	# The capability statement is the facade's (a test server states the capability it is going for; see
	# facade/src/main/resources/capability). It is tried first. If the facade is down, the request goes to HAPI
	# and returns HAPI's own statement, so a facade problem still cannot take FHIR discovery away.
	handle @meta {
		reverse_proxy facade:8080 hapi:8080 {
			lb_policy first
			lb_try_duration 3s
			lb_try_interval 250ms
			max_fails 1
			fail_duration 30s
		}
	}
	handle @preflight {
		reverse_proxy hapi:8080
	}
	handle @authed {
		reverse_proxy hapi:8080
	}
	handle {
		header WWW-Authenticate Bearer
		respond "Unauthorized: send Authorization: Bearer <token>" 401
	}
}
